<UserControl
    x:Class="Financisto.Reports.ReportByPeriodMonthCrc"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Financisto.Common.Controls;assembly=Financisto.Common"
    xmlns:filters="clr-namespace:Financisto.Common.Filters;assembly=Financisto.Common"
    xmlns:local="using:Financisto.Reports"
    xmlns:loc="clr-namespace:Financisto.Common.Localization;assembly=Financisto.Common"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    x:DataType="local:ReportByPeriodMonthCrcVM">
    <UserControl.Styles>
        <StyleInclude Source="avares://Financisto.Reports/ReportStyles.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="4,2">
                <TextBlock Classes="toolbarCaption" Text="{loc:Translate Key=view}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="GraphicsBtn"
                        Classes="iconRadio"
                        IsChecked="True"
                        ToolTip.Tip="{loc:Translate Key=graphics}">
                        <Image Source="{StaticResource IconChartBar}" />
                    </RadioButton>
                    <RadioButton
                        x:Name="GridBtn"
                        Classes="iconRadio"
                        ToolTip.Tip="{loc:Translate Key=grid}">
                        <Image Source="{StaticResource IconTableGray}" />
                    </RadioButton>
                </StackPanel>
            </StackPanel>
            <filters:CurrencyFilter Margin="4,2" />
            <filters:AccountFilter Margin="4,2" />
            <filters:CategoryFilter Margin="4,2" />
            <filters:ProjectFilter Margin="4,2" />
            <filters:PayeeFilter Margin="4,2" />
            <filters:StartYearMonthFilter Margin="4,2" />
            <filters:EndYearMonthFilter Margin="4,2" />
            <Button
                Classes="refresh"
                Command="{Binding RefreshDataCommand}"
                ToolTip.Tip="{loc:Translate Key=refresh}">
                <Image Source="{StaticResource IconRefresh}" />
            </Button>
        </WrapPanel>
        <lvc:CartesianChart
            Grid.Row="1"
            IsVisible="{Binding #GraphicsBtn.IsChecked}"
            LegendPosition="Top"
            Series="{Binding Chart.Series}"
            XAxes="{Binding Chart.XAxes}"
            YAxes="{Binding Chart.YAxes}" />
        <controls:DataGridAutoHeaders
            Grid.Row="1"
            IsVisible="{Binding #GridBtn.IsChecked}"
            ItemsSource="{Binding Entities}" />
    </Grid>
</UserControl>
