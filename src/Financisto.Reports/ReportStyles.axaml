<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Toolbar of every report: a caption above each group of controls  -->
    <Style Selector="TextBlock.toolbarCaption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,2,2" />
    </Style>

    <!--  Chart / grid switch: an icon-only radio button that looks like a toggle button  -->
    <Style Selector="RadioButton.iconRadio">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Border"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ContentPresenter
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.iconRadio:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundPointerOver}" />
    </Style>
    <Style Selector="RadioButton.iconRadio:checked /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
    </Style>
    <Style Selector="RadioButton.iconRadio:checked:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundCheckedPointerOver}" />
    </Style>

    <Style Selector="Button.refresh">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="8,0,2,0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  Tabs of opened reports: a close button in the header  -->
    <Style Selector="Button.closeTab">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
