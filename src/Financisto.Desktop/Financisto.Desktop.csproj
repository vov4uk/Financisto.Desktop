<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
       <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>Assets\ic_launcher.ico</ApplicationIcon>

    </PropertyGroup>

    <!-- macOS .app bundle, generated by MacBundle when publishing for an osx-* runtime -->
    <PropertyGroup>
        <MacOSBundleIdentifier>com.vov4uk.financisto.desktop</MacOSBundleIdentifier>
        <MacOSBundleName>Financisto</MacOSBundleName>
        <MacOSBundleDisplayName>Financisto</MacOSBundleDisplayName>
        <!-- ICNS needs standard sizes (16..256); ic_launcher.ico only has a single 220x220 image -->
        <MacOSBundleIcon>Assets\ic_launcher_macos.ico</MacOSBundleIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- NLog reads its config from next to the exe, so keep it out of the single-file bundle -->
        <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Update="NLog.xsd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Controls.DataGrid" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="AvaloniaWASM.Storage" />
        <PackageReference Include="Cogwheel" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="LiveChartsCore" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
        <PackageReference Include="MacBundle" />
        <PackageReference Include="Onova" />
        <PackageReference Include="Optris.LoadingIndicators.Avalonia" />
        <PackageReference Include="PdfPig" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Financisto.Desktop.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Financisto.Common\Financisto.Common.csproj" />
        <ProjectReference Include="..\Financisto.DataAccess\Financisto.DataAccess.csproj" />
        <ProjectReference Include="..\Financisto.Adapter\Financisto.Adapter.csproj" />
        <ProjectReference Include="..\Financisto.Reports\Financisto.Reports.csproj" />
        <ProjectReference Include="..\BankHelpers\Financisto.BankHelpers.Abstractions\Financisto.BankHelpers.Abstractions.csproj" />
        <ProjectReference Include="..\CustomControls\AvaloniaSearchableComboBox\AvaloniaSearchableComboBox.csproj" />
        <ProjectReference Include="..\CustomControls\Message.Avalonia\Message.Avalonia.csproj" />
    </ItemGroup>


    <!--
        Bank helper plugins (src/BankHelpers/Plugins/*): each project builds one DLL. The app doesn't reference them; it finds the DLLs in
        <app>/plugins at startup (PluginBankHelperProvider). They are built before the app and copied to plugins/ in the build output and in the
        publish folder (next to the single-file exe). To add a bank, add a project under Plugins, or just drop its DLL into the plugins folder.
    -->
    <ItemGroup>
        <BankHelperPlugin Include="..\BankHelpers\Plugins\*\*.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="@(BankHelperPlugin)" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The assemblies shared with the plugins; the plugin build reads the same file (see PluginLoadContext) -->
        <EmbeddedResource Include="..\BankHelpers\Plugins\HostProvidedAssemblies.txt" LogicalName="HostProvidedAssemblies.txt" />
    </ItemGroup>

    <!--
        Windows OCR (src/Ocr/Financisto.Ocr.Windows): the Windows API needs a windows target framework, so it is its own library, built only on Windows
        for the Windows runtimes and put in <app>/ocr (the folder is simply missing in the other builds, and the app goes without OCR). Like the plugins,
        the app has no code reference to it: it is built first and its output (the DLL, the Windows API projection, WinRT.Runtime) is copied and published.
    -->
    <PropertyGroup>
        <IncludeWindowsOcr Condition="$([MSBuild]::IsOSPlatform('Windows')) And $(RuntimeIdentifier.StartsWith('win-'))">true</IncludeWindowsOcr>
    </PropertyGroup>

    <ItemGroup Condition="'$(IncludeWindowsOcr)' == 'true'">
        <ProjectReference Include="..\Ocr\Financisto.Ocr.Windows\Financisto.Ocr.Windows.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>

    <Target Name="GetWindowsOcrOutputs" Condition="'$(IncludeWindowsOcr)' == 'true'">
        <MSBuild Projects="..\Ocr\Financisto.Ocr.Windows\Financisto.Ocr.Windows.csproj" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="WindowsOcrTargetPath" />
        </MSBuild>
        <ItemGroup>
            <WindowsOcrOutput Include="%(WindowsOcrTargetPath.RootDir)%(WindowsOcrTargetPath.Directory)*.dll;%(WindowsOcrTargetPath.RootDir)%(WindowsOcrTargetPath.Directory)*.deps.json" />
        </ItemGroup>
    </Target>

    <Target Name="CopyWindowsOcr" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="GetWindowsOcrOutputs" Condition="'$(IncludeWindowsOcr)' == 'true'">
        <Copy SourceFiles="@(WindowsOcrOutput)" DestinationFolder="$(OutDir)ocr" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishWindowsOcr" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="GetWindowsOcrOutputs" Condition="'$(IncludeWindowsOcr)' == 'true'">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(WindowsOcrOutput)" RelativePath="ocr/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>

    <Target Name="GetBankHelperPluginOutputs">
        <!-- The plugins are plain net10.0 libraries, built without the app's runtime (the SDK drops these properties for a library reference too) -->
        <MSBuild Projects="@(BankHelperPlugin)" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="BankHelperPluginOutput" />
        </MSBuild>
    </Target>

    <Target Name="CopyBankHelperPlugins" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="GetBankHelperPluginOutputs">
        <Copy SourceFiles="@(BankHelperPluginOutput)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishBankHelperPlugins" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="GetBankHelperPluginOutputs">
        <ItemGroup>
            <ResolvedFileToPublish Include="@(BankHelperPluginOutput)" RelativePath="plugins/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>

</Project>
