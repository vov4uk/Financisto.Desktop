<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Financisto.Desktop.ViewModels"
             xmlns:conv="using:Financisto.Converters"
             x:Class="Financisto.Desktop.Views.TransactionsPageView"
             x:DataType="vm:TransactionsPageViewModel">

    <UserControl.Resources>
        <conv:UnixTimeConverter x:Key="UnixTimeConverter" />
    </UserControl.Resources>

    <Grid Margin="10" RowDefinitions="Auto,*" ColumnDefinitions="*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0"
                       Text="Transactions"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="Loading..."
                       IsVisible="{Binding IsLoading}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <Button Content="Add Expense" Grid.Column="2" Command="{Binding AddCommand}" />
            <Button Content="Add Transfer" Grid.Column="3" Command="{Binding AddTransferCommand}" />
            <Button Content="Edit" Grid.Column="4" Command="{Binding EditCommand}" />
            <Button Content="Duplicate" Grid.Column="5" Command="{Binding DuplicateCommand}" />
            <Button Content="Delete" Grid.Column="6"  Command="{Binding DeleteCommand}" />
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Entities}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding Datetime, Converter={StaticResource UnixTimeConverter}}"
                                    Width="150" />
                <DataGridTextColumn Header="Account"
                                    Binding="{Binding AccountTitle}"
                                    Width="150" />
                <DataGridTextColumn Header="Category"
                                    Binding="{Binding CategoryTitle}"
                                    Width="130" />
                <DataGridTextColumn Header="Amount"
                                    Binding="{Binding AmountTitle}"
                                    Width="130" />
                <DataGridTextColumn Header="Balance"
                                    Binding="{Binding BalanceTitle}"
                                    Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
