<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Financisto.Desktop.ViewModels"
             xmlns:conv="using:Financisto.Converters"
             x:Class="Financisto.Desktop.Views.TransactionsPageView"
             x:DataType="vm:TransactionsPageViewModel">

    <UserControl.Resources>
        <conv:UnixTimeConverter x:Key="UnixTimeConverter" />
    </UserControl.Resources>

    <Grid Margin="10" RowDefinitions="Auto,*" ColumnDefinitions="*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0"
                       Text="Transactions"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="Loading..."
                       IsVisible="{Binding IsLoading}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <Button Grid.Column="2"
                    Content="Refresh"
                    Command="{Binding RefreshDataCommand}"
                    Width="90" Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Content="Export Excel"
                    Command="{Binding ExportarExcelCommand}"
                    Width="110" />
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Entities}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"
                                    Binding="{Binding Datetime, Converter={StaticResource UnixTimeConverter}}"
                                    Width="150" />
                <DataGridTextColumn Header="Account"
                                    Binding="{Binding AccountTitle}"
                                    Width="150" />
                <DataGridTextColumn Header="Category"
                                    Binding="{Binding CategoryTitle}"
                                    Width="130" />
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding TransactionTitle}"
                                    Width="*" />
                <DataGridTextColumn Header="Amount"
                                    Binding="{Binding AmountTitle}"
                                    Width="130" />
                <DataGridTextColumn Header="Balance"
                                    Binding="{Binding BalanceTitle}"
                                    Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
