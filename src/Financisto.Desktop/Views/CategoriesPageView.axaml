<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Financisto.Desktop.ViewModels.Pages"
             xmlns:model="using:Financisto.Common.Model"
             x:Class="Financisto.Desktop.Views.CategoriesPageView"
             x:DataType="vm:CategoriesVM">

    <Grid Margin="10" RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0"
                   Text="Categories"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="Add" Command="{Binding AddCommand}" />
            <Button Content="Edit" Command="{Binding EditCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
            <Button Content="Move Top" Command="{Binding MoveTopCommand}" />
            <Button Content="Move Up" Command="{Binding MoveUpCommand}" />
            <Button Content="Move Down" Command="{Binding MoveDownCommand}" />
            <Button Content="Move Bottom" Command="{Binding MoveBottomCommand}" />
            <Button Content="Sort By Title" Command="{Binding SortByTitleCommand}" />
        </StackPanel>

        <TreeView Grid.Row="2"
                  ItemsSource="{Binding Entities}"
                  SelectedItem="{Binding SelectedValue, Mode=TwoWay}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="model:CategoryTreeModel"
                                  ItemsSource="{Binding SubCategoties}">
                    <TextBlock Text="{Binding Title}" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

    </Grid>
</UserControl>
