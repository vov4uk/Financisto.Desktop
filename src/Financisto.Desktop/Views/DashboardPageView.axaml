<UserControl
    x:Class="Financisto.Desktop.Views.DashboardPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Financisto.Desktop.ViewModels.Pages"
    x:DataType="vm:DashboardPageVM"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">

            <!--  Cabeçalho  -->
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Bem vindo ao Dashboard!"
                    TextWrapping="Wrap" />

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Aqui será onde você poderá ver o resumo de seus ganhos e gastos"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Seção Pizza  -->
            <StackPanel Spacing="6">

                <TextBlock
                    Margin="5,24,0,0"
                    FontWeight="SemiBold"
                    Text="Distribuição geral"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="5,4,0,0"
                    FontSize="12"
                    Foreground="Gray"
                    Text="Resumo visual das suas receitas e despesas"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemAltMediumHighColor}"
                    BorderThickness="2"
                    CornerRadius="15">
                    <Grid ColumnDefinitions="*,*">
                        <lvc:PieChart
                            Grid.Column="0"
                            Height="320"
                            BorderBrush="{DynamicResource SystemAltMediumHighColor}"
                            LegendPosition="Left"
                            Series="{Binding PieSeries}" />
                    </Grid>
                    <TextBlock Grid.Column="1">TOTAL</TextBlock>

                </Border>

            </StackPanel>

            <!--  Seção Linha  -->
            <StackPanel Spacing="6">

                <TextBlock
                    Margin="5,14,0,0"
                    FontWeight="SemiBold"
                    Text="Evolução anual do saldo"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="5,4,0,0"
                    FontSize="12"
                    Foreground="Gray"
                    Text="Mostra como seus ganhos evoluíram ao longo dos anos"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource SystemAltHighColor}"
                    BorderBrush="{DynamicResource SystemAltMediumHighColor}"
                    BorderThickness="2"
                    CornerRadius="15">

                    <lvc:CartesianChart
                        Height="350"
                        LegendPosition="Top"
                        Series="{Binding LineSeries}"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}" />

                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
