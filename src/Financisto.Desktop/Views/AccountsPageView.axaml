<UserControl
    x:Class="Financisto.Desktop.Views.AccountsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Financisto.Common.Behaviors"
    xmlns:conv="using:Financisto.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Financisto.Common.Localization;assembly=Financisto.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Financisto.Desktop.ViewModels.Pages"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="vm:AccountsPageVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:UnixTimeConverter x:Key="UnixTimeConverter" />
            <conv:AccountTypeConverter x:Key="AccountTypeConverter" />
            <conv:AccentColorBrushConverter x:Key="AccentColorBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.totalAmount">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid
        Margin="10"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Margin="0,0,0,10"
            ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{loc:Translate Key=accounts}" />
            <Button
                Grid.Column="1"
                Margin="4,2"
                Classes="icon"
                Command="{Binding AddCommand}"
                Content="{loc:Translate Key=add}"
                Tag="{StaticResource IconPlus}" />
            <Button
                Grid.Column="2"
                Margin="4,2"
                Classes="icon"
                Command="{Binding EditCommand}"
                Content="{loc:Translate Key=edit}"
                Tag="{StaticResource IconPencil}" />
            <Button
                Grid.Column="3"
                Margin="4,2"
                Classes="icon"
                Command="{Binding DeleteCommand}"
                Content="{loc:Translate Key=delete}"
                Tag="{StaticResource IconTrash}" />
        </Grid>
        <DataGrid
            Grid.Row="1"
            Margin="5"
            VerticalAlignment="Stretch"
            behaviors:CommandBehavior.DoubleTappedCommand="{Binding EditCommand}"
            AutoGenerateColumns="False"
            Classes="activeStatus"
            FontSize="18"
            IsReadOnly="True"
            ItemsSource="{Binding Path=Entities}"
            SelectedItem="{Binding SelectedValue, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Panel Height="64">
                                <!--  Accent color: Android draws it as a gradient behind the account icon  -->
                                <Border Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}" />
                                <Image Height="64" IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource AccountTypeConverter}">
                                            <Binding Path="Type" />
                                            <Binding Path="CardIssuer" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <!--  Icon text (e.g. an emoji) replaces the image, like Android's setAccountIcon  -->
                                <TextBlock
                                    MinWidth="64"
                                    MaxWidth="100"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="40"
                                    IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    MaxLines="1"
                                    Text="{Binding Icon}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <Image
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    IsVisible="{Binding !IsActive}"
                                    Source="{StaticResource IconLock}" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Path=Title}" Header="{loc:Translate Key=title}" />
                <DataGridTextColumn Binding="{Binding Path=AccountDescription}" Header="{loc:Translate Key=description}" />
                <DataGridTemplateColumn Header="{loc:Translate Key=total_amount}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Classes="totalAmount balanceAmount"
                                Classes.negative="{Binding IsTotalAmountNegative}"
                                Text="{Binding Path=AmountTitle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Binding="{Binding Path=IsIncludeIntoTotals}" Header="{loc:Translate Key=include}" />
                <DataGridTextColumn Binding="{Binding Path=LastTransactionDate, Converter={StaticResource UnixTimeConverter}}" Header="{loc:Translate Key=last_transaction}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
