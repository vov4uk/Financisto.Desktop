<UserControl
    x:Class="Financisto.Desktop.Views.RulesPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Financisto.Common.Behaviors"
    xmlns:conv="using:Financisto.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Financisto.Common.Localization;assembly=Financisto.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Financisto.Desktop.ViewModels.Pages"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="vm:RulesPageVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid
        Margin="10"
        ColumnDefinitions="*,Auto,Auto,Auto"
        RowDefinitions="Auto,*">
        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            Text="{loc:Translate Key=rules}" />
        <Button
            Grid.Column="1"
            Margin="4,2"
            Classes="icon"
            Command="{Binding AddCommand}"
            Content="{loc:Translate Key=add}"
            Tag="{StaticResource IconPlus}" />
        <Button
            Grid.Column="2"
            Margin="4,2"
            Classes="icon"
            Command="{Binding EditCommand}"
            Content="{loc:Translate Key=edit}"
            Tag="{StaticResource IconPencil}" />
        <Button
            Grid.Column="3"
            Margin="4,2"
            Classes="icon"
            Command="{Binding DeleteCommand}"
            Content="{loc:Translate Key=delete}"
            Tag="{StaticResource IconTrash}" />
        <DataGrid
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Margin="5"
            behaviors:CommandBehavior.DoubleTappedCommand="{Binding EditCommand}"
            AutoGenerateColumns="False"
            Classes="activeStatus"
            FontSize="14"
            IsReadOnly="True"
            ItemsSource="{Binding Entities}"
            SelectedItem="{Binding SelectedValue}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsActive}" Header="{loc:Translate Key=active}" />
                <DataGridTextColumn Binding="{Binding Created, Mode=OneWay}" Header="{loc:Translate Key=created}" />
                <DataGridTextColumn Binding="{Binding Condition, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}" Header="{loc:Translate Key=condition}" />
                <DataGridTextColumn Binding="{Binding UserFirendlyDescription}" Header="{loc:Translate Key=description}" />
                <DataGridTextColumn Binding="{Binding Title}" Header="{loc:Translate Key=title}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
