<Window
    x:Class="Financisto.Desktop.Views.Dialogs.MessageBoxWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Financisto.Common.Localization;assembly=Financisto.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="300"
    MaxWidth="500"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <StackPanel Margin="20" Spacing="20">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />

        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Name="YesButton"
                Click="OnYesClick"
                Content="{loc:Translate Key=yes}"
                IsVisible="False" />
            <Button
                Name="NoButton"
                Click="OnNoClick"
                Content="{loc:Translate Key=no}"
                IsVisible="False" />
            <Button
                Name="OkButton"
                Click="OnOkClick"
                Content="{loc:Translate Key=ok}" />
        </StackPanel>
    </StackPanel>
</Window>
