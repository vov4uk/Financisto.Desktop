<Window
    x:Class="Financisto.Desktop.Wizards.WizardWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Financisto.Common.Localization;assembly=Financisto.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:import="using:Financisto.Desktop.Wizards.Import"
    xmlns:recipes="using:Financisto.Desktop.Wizards.Recipes"
    xmlns:wizards="using:Financisto.Desktop.Wizards"
    Title="{Binding Title}"
    Width="1100"
    Height="620"
    MinWidth="300"
    MinHeight="200"
    d:DesignHeight="620"
    d:DesignWidth="1100"
    x:DataType="wizards:WizardBaseVM"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  Wizard pages resolve here, before the app-wide ViewLocator (which matches every BindableBase).  -->
    <Window.DataTemplates>
        <DataTemplate DataType="import:Page1VM">
            <import:Page1 IsVisible="{Binding IsCurrentPage}" />
        </DataTemplate>
        <DataTemplate DataType="import:Page2VM">
            <import:Page2 IsVisible="{Binding IsCurrentPage}" />
        </DataTemplate>
        <DataTemplate DataType="import:Page3VM">
            <import:Page3 IsVisible="{Binding IsCurrentPage}" />
        </DataTemplate>
        <DataTemplate DataType="recipes:Page1VM">
            <recipes:Page1 IsVisible="{Binding IsCurrentPage}" />
        </DataTemplate>
        <DataTemplate DataType="recipes:Page2VM">
            <recipes:Page2 IsVisible="{Binding IsCurrentPage}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Margin="10" RowDefinitions="*,Auto,Auto">
        <!--
            Every page keeps its view and only the current one is visible. Swapping views in a ContentControl
            detaches the old one, and its DataGrid then clears the selection bound to the page (e.g. the start transaction).
        -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Panel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!--  Why the wizard could not finish (its result could not be made); the details are in the log  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            Foreground="OrangeRed"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="0,10,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    Command="{Binding MovePreviousCommand}"
                    Content="{loc:Translate Key=back}" />
                <Button
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    Command="{Binding MoveNextCommand}">
                    <Panel>
                        <TextBlock IsVisible="{Binding !IsOnLastPage}" Text="{loc:Translate Key=next_step}" />
                        <TextBlock IsVisible="{Binding IsOnLastPage}" Text="{loc:Translate Key=finish}" />
                    </Panel>
                </Button>
                <Button
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Translate Key=cancel}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
