<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Financisto.Converters"
    xmlns:data="using:Financisto.Common.Model">

    <Styles.Resources>
        <conv:ActiveStatusOpacityConverter x:Key="activeStatusOpacity" />
    </Styles.Resources>

    <Style x:DataType="data:IActive" Selector="DataGrid.activeStatus DataGridRow">
        <Setter Property="Opacity" Value="{Binding IsActive, Converter={StaticResource activeStatusOpacity}}" />
    </Style>

</Styles>
