<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Financisto.Converters"
    xmlns:data="using:Financisto.Common.Model">

    <Styles.Resources>
        <conv:ActiveStatusOpacityConverter x:Key="activeStatusOpacity" />
    </Styles.Resources>

    <Style x:DataType="data:IActive" Selector="DataGrid.activeStatus DataGridRow">
        <Setter Property="Opacity" Value="{Binding IsActive, Converter={StaticResource activeStatusOpacity}}" />
    </Style>

    <!--  Numeric columns of DataGridAutoHeaders  -->
    <Style Selector="DataGridCell.numeric TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

     <Style Selector="DataGrid">
       <Setter Property="GridLinesVisibility" Value="All" />
     </Style>

</Styles>
