<UserControl x:Class="Financisto.Common.Filters.ProjectFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcrd="using:Financisto.Common.Entities"
             xmlns:loc="using:Financisto.Common.Localization"
             MinWidth="140">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=project}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
        <ComboBox ItemTemplate="{StaticResource IActive}"
                  IsTextSearchEnabled="True"
                  TextSearch.TextBinding="{Binding Title}"
                  IsEditable="True"
                  Margin="2 0"
                  SelectedItem="{Binding Path=Project}"
                  ItemsSource="{Binding Source={x:Static fcrd:DbManual.Project}, Mode=OneWay}" />
    </StackPanel>
</UserControl>
