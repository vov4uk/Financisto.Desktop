<UserControl x:Class="Financisto.Common.Filters.CurrencyFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcrd="using:Financisto.Common.Entities"
             xmlns:loc="using:Financisto.Common.Localization"
             Width="140">
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=currency}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
        <ComboBox DisplayMemberBinding="{Binding Name}"
                  IsEditable="True"
                  SelectedItem="{Binding Path=CurentCurrency}"
                  Margin="2 0"
                  ItemsSource="{Binding Source={x:Static fcrd:DbManual.Currencies}, Mode=OneWay}" />
    </StackPanel>
</UserControl>
