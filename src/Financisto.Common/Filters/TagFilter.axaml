<UserControl
    x:Class="Financisto.Common.Filters.TagFilter"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Financisto.Common.Controls"
    xmlns:loc="using:Financisto.Common.Localization"
    x:Name="TagFilterInstance"
    MinWidth="140">
    <StackPanel>
        <TextBlock
            Margin="2,0,2,2"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{loc:Translate Key=tag}" />
        <controls:TagSelector
            Margin="2,0"
            SelectedTags="{Binding Path=SelectedTags, ElementName=TagFilterInstance, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
