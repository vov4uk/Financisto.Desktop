<UserControl x:Class="Financisto.Common.Filters.CategoryFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcrd="using:Financisto.Common.Entities"
             xmlns:loc="using:Financisto.Common.Localization"
             xmlns:sc="using:AvaloniaSearchableComboBox"
             MinWidth="140">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=category}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
        <sc:SearchableComboBox Margin="2 0"
                  ItemTemplate="{StaticResource CategoryTemplate}"
                  TextPath="Title"
                  SelectedItem="{Binding Path=Category}"
                  ItemsSource="{Binding Source={x:Static fcrd:DbManual.Category}, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
