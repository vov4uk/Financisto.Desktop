<UserControl
    x:Class="Financisto.Common.Filters.AccountsFilter"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Financisto.Common.Localization"
    MinWidth="140">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Financisto.Common/Assets/Generic.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock
            Margin="2,0,2,2"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{loc:Translate Key=account}" />
        <Button
            x:Name="HeaderButton"
            Theme="{StaticResource ComboLikeButton}"
            Height="32"
            Margin="2,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            MaxWidth="220">
            <TextBlock x:Name="HeaderText" TextTrimming="CharacterEllipsis" />
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <Grid MinWidth="180" MaxHeight="260">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" MaxHeight="220">
                            <ItemsControl x:Name="AccountsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,2"
                                            Content="{Binding Account.Title}"
                                            Foreground="{Binding Account.IsActive, Converter={StaticResource activeStatusBrush}}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Click="OnClearClick"
                            Content="{loc:Translate Key=clear}" />
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
