<UserControl x:Class="Financisto.Common.Filters.DateFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Financisto.Converters"
             xmlns:loc="using:Financisto.Common.Localization"
             Width="150">
    <UserControl.Resources>
        <conv:DateTimeToDateTimeOffsetConverter x:Key="DateTimeToDateTimeOffsetConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=date}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
        <!-- Avalonia's DatePicker.SelectedDate is DateTimeOffset?, unlike WPF's DateTime?, and the host's DateFilter is a DateTime? -->
        <DatePicker SelectedDate="{Binding DateFilter, Converter={StaticResource DateTimeToDateTimeOffsetConverter}}"
                    DayFormat="dd"
                    MonthFormat="MM"
                    YearFormat="yyyy"
                    Margin="2 0"/>
    </StackPanel>
</UserControl>
