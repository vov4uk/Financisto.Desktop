<UserControl x:Class="Financisto.Common.Filters.DateFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Financisto.Common.Localization"
             Width="120">
    <StackPanel>
        <TextBlock Text="{loc:Translate Key=date}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
        <!-- Avalonia's DatePicker.SelectedDate is DateTimeOffset?, unlike WPF's DateTime? -->
        <DatePicker SelectedDate="{Binding DateFilter}"
                    Margin="2 0"/>
    </StackPanel>
</UserControl>
