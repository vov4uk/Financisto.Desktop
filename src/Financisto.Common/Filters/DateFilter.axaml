<UserControl
    x:Class="Financisto.Common.Filters.DateFilter"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Financisto.Converters"
    xmlns:loc="using:Financisto.Common.Localization"
    Width="164">
    <UserControl.Resources>
        <conv:DateTimeToDateTimeOffsetConverter x:Key="DateTimeToDateTimeOffsetConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock
            Margin="2,0,2,2"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{loc:Translate Key=date}" />
        <!--  Avalonia's DatePicker.SelectedDate is DateTimeOffset?, unlike WPF's DateTime?, and the host's DateFilter is a DateTime?  -->
        <DatePicker
            MinWidth="160"
            Margin="2,0"
            DayFormat="dd"
            MonthFormat="MM"
            SelectedDate="{Binding DateFilter, Converter={StaticResource DateTimeToDateTimeOffsetConverter}}"
            YearFormat="yyyy" />
    </StackPanel>
</UserControl>
