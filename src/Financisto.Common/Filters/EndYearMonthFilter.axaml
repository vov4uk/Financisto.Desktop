<UserControl x:Class="Financisto.Common.Filters.EndYearMonthFilter"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcrd="using:Financisto.Common.Entities"
             xmlns:loc="using:Financisto.Common.Localization"
             Width="120">
  <StackPanel>
    <TextBlock Text="{loc:Translate Key=to_}" FontSize="12" FontWeight="SemiBold" Margin="2 0 2 2"/>
    <ComboBox Margin="2 0"
              IsEditable="True"
              DisplayMemberBinding="{Binding Name}"
              SelectedItem="{Binding Path=EndYearMonths}"
              ItemsSource="{Binding Source={x:Static fcrd:DbManual.YearMonths}, Mode=OneWay}" />
  </StackPanel>
</UserControl>
